# better-sqlite3 ships prebuilt binaries for linux/darwin/win32 x64+arm64 inside
# its npm tarball, so nothing needs compiling here. But it also ships a
# binding.gyp and declares no install script, and npm's response to that pair is
# to run `node-gyp rebuild` implicitly — which fails on any machine without a
# C++ toolchain, this one included.
#
# Skipping install scripts avoids that. The only other packages in the tree with
# them are esbuild and unrs-resolver, both of which resolve their platform
# binary through optional dependencies and work without their postinstall.
#
# Verified by a clean `git clone` + `npm ci` + `npm run build` + `npm start`.
ignore-scripts=true
