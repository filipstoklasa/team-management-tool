{
  "name": "moodys-team-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test src/domain/*.test.ts",
    "db:generate:allocation": "drizzle-kit generate --config=drizzle.config.allocation.ts",
    "db:migrate:allocation": "node scripts/ensure-data-dir.ts && drizzle-kit migrate --config=drizzle.config.allocation.ts",
    "db:generate:people": "drizzle-kit generate --config=drizzle.config.people.ts",
    "db:migrate:people": "node scripts/ensure-data-dir.ts && drizzle-kit migrate --config=drizzle.config.people.ts",
    "db:migrate": "npm run db:migrate:allocation && npm run db:migrate:people",
    "db:seed": "node scripts/seed.ts",
    "db:backup": "node scripts/backup.ts",
    "db:restore": "node scripts/restore.ts",
    "db:reset": "rm -rf data && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
