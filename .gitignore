# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environment
.env*
!.env.example

# Databases — never commit (§7, §9.2)
# people.db holds personal data about identifiable employees.
# allocation.db is excluded too: it is generated from migrations + seed.
data/
*.db
*.db-wal
*.db-shm
*.sqlite

# Exports (§9.2 — separate export paths)
exports/

# Database backups — same rule as data/ (§7, §9.2)
backup/

# Tests
playwright-report/
test-results/

# OS / editor
.DS_Store
*.swp
