# Dependencies
node_modules/

# Next.js build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Environment
.env*
!.env.example

# Databases — never commit (§7, §9.2).
# Anchored with a leading slash: an unanchored `data/` also matches src/data/,
# which silently kept the entire read layer out of the repository.
# app.db holds personal data about identifiable people, and is generated from
# migrations + seed in any case.
/data/
*.db
*.db-wal
*.db-shm
*.sqlite

# Exports (§9.2 — separate export paths)
/exports/

# Database backups — same rule as data/ (§7)
/backup/

# Tests
/playwright-report/
/test-results/

# OS / editor
.DS_Store
*.swp
